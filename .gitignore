# Ignore sensitive configuration
credentials.txt
.env
scripts/libinsights_credentials.xml
scripts/*_credentials.xml

# Ignore output data files (but allow folder structure)
# Use ** so nested output dirs are covered too - a single * does not cross
# directory separators, so output/csv/*.csv would miss output/csv/gate_counts/
output/csv/**/*.csv
output/json/**/*.json
!output/csv/.gitkeep
!output/json/.gitkeep

# Ignore logs and temporary files
logs/
*.log
*.tmp

# Ignore PowerShell execution artifacts
*.ps1xml

# Ignore Windows system files
Thumbs.db
desktop.ini
*.lnk

# Ignore backup and temporary files
*~
*.bak
*.swp
*.orig

# Ignore IDE files
.vscode/
.vs/
*.suo
*.user